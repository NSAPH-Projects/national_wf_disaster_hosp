raster_dir <- file.path(base_dir, sprintf("PRISM_tmean_stable_4kmM3_%d_all_bil", year))
raster_path <- file.path(raster_dir, sprintf("PRISM_tmean_stable_4kmM3_%d%s_bil.bil", year, month_str))
raster_full <- raster(raster_path)
raster_full <- projectRaster(raster_full, crs = zcta_proj)
weighted_area <- lapply(zctas_of_interest, function(single_zcta) {
current_zcta <- zctas[zctas$zcta == single_zcta, ]
current_value <- raster::extract(
x = raster_full,
weights = TRUE,
normalizeWeights = TRUE,
y = current_zcta,
fun = mean,
df = TRUE,
na.rm = TRUE
)
data.frame(
zcta = single_zcta,
tmean = current_value[1, 2],
year = year,
month = month_str
)
})
single_zcta = zctas_of_interest[1]
single_zctas
single_zcta
